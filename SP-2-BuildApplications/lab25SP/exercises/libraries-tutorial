
########## Исходные файлы ##########

---------- math.h (Создание заголовочного файла) ----------

#ifndef MATH_H
#define MATH_H

double pow(double x, double n);

#endif

---------- math.c (Создание файла с реализацией) ----------

double pow(double x, double n) {
	int result = x;
	for (int i = 1; i < n; i++) {
		result *= x;
	}
	return result;
}

---------- main.c (Создание основной программы) ----------

#include <stdio.h>
#include "math.h"

int main() {
	int base, power, result;

	printf("Enter the base of the number: ");
	scanf("%d", &base);

	printf("Enter the power of the number: ");
        scanf("%d", &power);

	result = pow(base, power);
	printf("%d ^ %d = %d\n", base, power, result);

	return 0;
}

